
@using Microsoft.AspNetCore.Http;

@{

    //here we can get the IDs from STUDENTController
    int? regid = Context.Session.GetInt32(SD.KeyUser);
    int? roleid = Context.Session.GetInt32(SD.KeyRole);


    
}

<!DOCTYPE html>

<html>
<head>
