
@{
    ViewData["title"] = "Fail-Student-List";
}

<div class="content-wrapper">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h2 class="card-title">Fail Student Details</h2>
                <div class="d-flex justify-content-end">
                    <button id="btnDownLoadExcel" class="btn btn-success mb-3">
                        Download  Excel
                    </button>
                </div>
                <table id="dataTable" class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Student Name</th>
                            <th>Class</th>
                            <th>Section</th>
                            <th>Subject</th>
                            <th>Marks</th>
                            <th>Percentage</th>
                            <th>result</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div> <!-- end col -->
</div>
@section Scripts{
    <script src="~/js/FailStudentListJs.js" asp-append-version="true"></script>
    <script src="~/js/excel helper/excel-helper.js"></script>
    <script src="~/js/excel download/teacher_fail_student_download.js" asp-append-version="true"></script>
}
